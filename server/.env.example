PORT=3001
NODE_ENV=production

# PostgreSQL — di production (VPS) isi manual sesuai instance Postgres di server
DATABASE_URL=postgresql://user:password@localhost:5432/management_dashboard

# JWT — generate dengan: openssl rand -hex 32
JWT_SECRET=ganti_random_string_minimal_32_karakter
REFRESH_TOKEN_SECRET=ganti_random_string_lain_minimal_32_karakter

# URL frontend production (di-serve Express sebagai static build, di belakang nginx)
CLIENT_URL=https://app.domain-anda.com

# URL dashboard (untuk link di pesan Telegram Bot)
DASHBOARD_URL=https://app.domain-anda.com

# Telegram Bot — token dari @BotFather
TELEGRAM_BOT_TOKEN=
# Username bot tanpa @ (dipakai di petunjuk "Hubungkan Telegram" web unit)
TELEGRAM_BOT_USERNAME=
# ID grup Telegram koordinator untuk kabar order baru (utils/notifGrup.js). Kosong = mati. Ambil: tambah bot ke grup, ketik /idgrup.
TELEGRAM_GRUP_ORDER=
# Opsional: topik di grup (message_thread_id) & token bot lain (mis. bot lapor updateorderstd). Kosong = tanpa topik / TELEGRAM_BOT_TOKEN.
TELEGRAM_TOPIK_ORDER=
TELEGRAM_BOT_ORDER_TOKEN=

# Google Gemini API — untuk fitur AI Intelligence (server/src/controllers/ai.js)
GEMINI_API_KEY=

# Opsional — branding ekosistem, ada default fallback ('Ekosistem' / 'Ekosistem') kalau dikosongkan
ECOSYSTEM_NAME=
ECOSYSTEM_NAME_FULL=

# Jembatan login Jalur Tumbuh (tumbuh.kariranak.com) — string acak >=32 karakter, SAMA dengan rahasia jembatan di server/.env Tumbuh.
# Kosong = pintu /api/vokasi tertutup (selalu 404).
VOKASI_RAHASIA=
