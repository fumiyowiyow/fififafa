// ══════════════════════════════════════════════════════════════════════════
// KEHADIRAN (20 Okt 2026) — adaptasi OGS Attendance (AttendanceEvent/Leave/OvertimeEntry), DailyStateCheckIn, OgsCalendarEvent.
// Data pribadi: presensi & cuti hanya dilihat orangnya + koordinator unitnya; CHECK-IN HARIAN bersifat PRIBADI (koordinator hanya
// melihat siapa yang sudah mengisi + agregat, bukan emosi per orang). Jam kerja mengikuti utils/jamKerja.js (WIB).
// ══════════════════════════════════════════════════════════════════════════
model KehadiranEvent {
  id            String   @id @default(cuid())
  userId        String
  tanggalKerja  DateTime @db.Date
  jenis         String   // MASUK | PULANG | KELUAR | KEMBALI
  jenisKeluar   String?  // ISTIRAHAT | SHOLAT | MEROKOK | KELUAR_STUDIO
  modeKerja     String?  // WFO | WFA
  lokasiWfa     String?  // RUMAH_KOS | CAFE | LAINNYA
  dicatatPada   DateTime @default(now())
  catatan       String?
  // 16 Nov 2026 (masukan tim): unit tempat ia bekerja hari itu (dipilih saat MASUK) → jam kerja unit itu yang dipakai;
  // otomatis = PULANG yang dibuat sistem (pulang otomatis unit), bukan ketukan orangnya
  studioId      String?
  otomatis      Boolean  @default(false)

  @@index([userId, tanggalKerja])
  @@index([tanggalKerja, jenis])
}

// JAM KERJA PER UNIT (16 Nov 2026, masukan timLangit): diatur Koordinator unit (CEO unit). Tanpa baris = jadwal bawaan
// (utils/jamKerja.js JADWAL: Sen–Jum 09–17, Sab 09–16, istirahat 12–13, Jumat 11:30–13:30). jadwal = { "1": { kerja: ["08:30","16:30"],
// istirahat: ["11:30","13:00"] } | null (libur), …, "6": … } — 1 = Senin … 6 = Sabtu; Minggu selalu libur.
// pulangOtomatis: sesi tanpa presensi pulang ditutup sistem saat jam `batasPulang` (HH:MM) dengan waktu pulang = jam pulang resmi →
// jam kerja terhitung, TIDAK menjadi lembur. Hanya sesi yang dimulai sejak `aktifSejak` (tidak mengubah riwayat lama).
model JamKerjaUnit {
  studioId       String    @id
  jadwal         Json
  pulangOtomatis Boolean   @default(false)
  batasPulang    String?
  aktifSejak     DateTime?
  diubahOleh     String?
  updatedAt      DateTime  @updatedAt
}

model CutiKehadiran {
  id            String   @id @default(cuid())
  userId        String
  jenis         String   // SAKIT | IZIN | CUTI | DINAS_LUAR | LAINNYA
  mulai         DateTime @db.Date
  selesai       DateTime @db.Date
  durasi        String   @default("SEHARI") // SEHARI | SETENGAH_PAGI | SETENGAH_SORE
  alasan        String
  status        String   @default("MENUNGGU") // MENUNGGU | DISETUJUI | DITOLAK | DIBATALKAN
  ditinjauOlehId String?
  ditinjauOleh  String?
  ditinjauPada  DateTime?
  catatanPeninjau String?
  createdAt     DateTime @default(now())

  @@index([userId, mulai, selesai])
  @@index([status, mulai])
}

model LemburKehadiran {
  id            String   @id @default(cuid())
  userId        String
  penggajianId  String?  // diklaim Payroll Ekosistem saat Generate (bila tarif lembur/jam unit diisi) — mencegah dihitung dua kali
  penggajian    Penggajian? @relation(fields: [penggajianId], references: [id], onDelete: SetNull)
  tanggalKerja  DateTime @db.Date
  sumber        String   // OTOMATIS | MANUAL
  mulai         DateTime
  selesai       DateTime
  menit         Int
  catatan       String?
  // 21 Okt 2026: unit tempat lembur (Payroll unit X hanya mengklaim lembur unit X) + persetujuan koordinator
  studioId      String?
  status        String   @default("DISETUJUI") // MENUNGGU | DISETUJUI | DITOLAK — hanya DISETUJUI yang dibayar
  ditinjauOlehId String?
  ditinjauOleh  String?
  ditinjauPada  DateTime?
  catatanPeninjau String?
  // 9 Nov 2026 (mode lembur PER_PROYEK): order yang dilemburkan + nilai lembur yang diisi koordinator saat menyetujui
  orderId       String?
  nilaiProyek   Float?
  // 9 Nov 2026 (mode PER_LEVEL, acuan hitung Sekai Land): level pekerjaan + progres awal–akhir (0–1); fee level DIKUNCI saat dicatat
  levelId       String?
  levelNama     String?
  feeLevel      Float?
  progresAwal   Float?
  progresAkhir  Float?

  @@index([userId, tanggalKerja])
  @@index([studioId, status])
}

model CheckInHarian {
  id            String   @id @default(cuid())
  userId        String
  tanggal       DateTime @db.Date
  status        String   // DIISI | DILEWATI
  emosi         String?
  intensitas    Int?
  kejernihan    Int?
  fokusPikiran  String?
  kebutuhan     String?
  createdAt     DateTime @default(now())

  @@unique([userId, tanggal])
  @@index([tanggal, status])
}

model AcaraKalender {
  id            String   @id @default(cuid())
  lingkupJenis  String   // circle | rumah-usaha
  lingkupId     String
  judul         String
  tanggal       DateTime @db.Date
  seharian      Boolean  @default(false)
  mulai         String?  // HH:MM
  selesai       String?  // HH:MM
  lokasi        String?
  deskripsi     String?
  berulang      String?  // MINGGUAN | BULANAN | TAHUNAN
  berulangDihentikan DateTime? @db.Date
  dibuatOlehId  String?
  createdAt     DateTime @default(now())

  @@index([lingkupJenis, lingkupId, tanggal])
}

// REFLEKSI MINGGUAN web circle (21 Okt 2026) — adaptasi OGS SdmReflection/SdmReflectionComment. Satu refleksi per orang per minggu (Senin WIB).
model RefleksiMingguan {
  id            String   @id @default(cuid())
  userId        String
  mingguMulai   DateTime @db.Date
  kategori      String
  tingkat       Int      // 1–5 (≥4 = perlu dukungan)
  hambatan      String
  komitmen      String?
  perluDukungan Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  komentar      KomentarRefleksi[]

  @@unique([userId, mingguMulai])
  @@index([mingguMulai])
}

model KomentarRefleksi {
  id          String   @id @default(cuid())
  refleksiId  String
  refleksi    RefleksiMingguan @relation(fields: [refleksiId], references: [id], onDelete: Cascade)
  penulisId   String
  penulis     String
  isi         String
  createdAt   DateTime @default(now())

  @@index([refleksiId])
}

// LTK (Lempar-Terima Kerjaan) web circle (21 Okt 2026) — adaptasi OGS LtkCase, SISI STAF SAJA (tanpa portal pihak luar). TERIMA = pihak luar
// membawa pekerjaan ke studio (kode PO-…), LEMPAR = studio melempar pekerjaan keluar (kode LMP-…). Negosiasi dicatat sebagai catatan.
// DEAL + TERIMA → dikonversi jadi OrderProduksi (orderId).
model KasusLtk {
  id              String   @id @default(cuid())
  kode            String   @unique
  arah            String   // TERIMA | LEMPAR
  status          String   @default("DRAFT") // DRAFT | DIAJUKAN | NEGOSIASI | DEAL | DITOLAK | DIBATALKAN
  studioId        String
  akunId          String?
  namaPihak       String
  jenisPihak      String   // KOMUNITAS | FREELANCE
  kontak          String?
  judul           String
  kategori        String?
  deskripsi       String?
  anggaranCatatan String?
  deadlineDiminta DateTime? @db.Date
  tautanRujukan   String[] @default([])
  hargaSepakat    Float?
  deadlineSepakat DateTime? @db.Date
  syarat          String?
  tautanHasil     String?
  pemasarId       String?
  dibuatOlehId    String
  orderId         String?
  diajukanPada    DateTime?
  dealPada        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  catatan         CatatanLtk[]

  @@index([studioId, status])
  @@index([arah, status])
}

model CatatanLtk {
  id        String   @id @default(cuid())
  kasusId   String
  kasus     KasusLtk @relation(fields: [kasusId], references: [id], onDelete: Cascade)
  penulisId String
  penulis   String
  isi       String
  createdAt DateTime @default(now())

  @@index([kasusId])
}

// TAGIHAN KOMUNITAS web circle (21 Okt 2026) — adaptasi OGS CommunityInvoice, sisi staf. Menggabungkan beberapa order satu klien jadi satu tagihan.
// Lunas → status bayar order terkait ikut LUNAS. Nilai = nilaiKotor order (Rp).
model TagihanKomunitas {
  id           String   @id @default(cuid())
  nomor        String   @unique
  studioId     String
  klien        String
  status       String   @default("DRAFT") // DRAFT | DITAGIH | LUNAS | BATAL
  total        Float    @default(0)
  catatan      String?
  tautanBukti  String?
  ditagihPada  DateTime?
  lunasPada    DateTime?
  dibuatOlehId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  item         TagihanKomunitasItem[]

  @@index([studioId, status])
}

model TagihanKomunitasItem {
  id        String   @id @default(cuid())
  tagihanId String
  tagihan   TagihanKomunitas @relation(fields: [tagihanId], references: [id], onDelete: Cascade)
  orderId   String
  jumlah    Float
  keterangan String? // DP | Pelunasan | teks lain — invoice per order dari detail order (12 Nov 2026); kosong = nilai penuh order (tagihan gabungan lama)
  urutan    Int      @default(0)

  @@index([tagihanId])
  @@index([orderId])
}

// PENERBIT INVOICE per unit (9 Nov 2026, keputusan user): diisi SENDIRI oleh koordinator di web circle — teks yang memang untuk dibagikan ke
// klien (nama penerbit, rekening penerima, catatan kaki). SENGAJA terpisah dari StudioRekening Ekosistem: rekening Ekosistem tetap tidak dikirim ke web circle.
model PengaturanInvoice {
  id          String   @id @default(cuid())
  studioId    String   @unique
  namaPenerbit String?  // kosong = nama studio
  rekening    String?  // teks bebas, mis. "BCA 1234567890 a.n. Studio X"
  catatanKaki String?
  diubahOleh  String?
  updatedAt   DateTime @updatedAt
}

// CHECKLIST SETORAN MARKETER web circle (21 Okt 2026) — adaptasi OGS finance_v2_marketer_checklists: tiap tanggal 11 & 24 tiap marketer × unit
// mendapat satu checklist "sudah setor pemasukan". Dibuat otomatis saat dibuka (tanpa cron). Boleh ditautkan ke TransferPendapatan.
model ChecklistSetor {
  id          String   @id @default(cuid())
  studioId    String
  marketerId  String
  periode     DateTime @db.Date // tanggal 11 atau 24
  status      String   @default("MENUNGGU") // MENUNGGU | SELESAI
  transferId  String?
  catatan     String?
  selesaiPada DateTime?
  createdAt   DateTime @default(now())

  @@unique([studioId, marketerId, periode])
  @@index([studioId, periode])
}

// RIWAYAT LOGIN (21 Okt 2026) — adaptasi OGS user_login_logs. Dicatat tiap login berhasil (Ekosistem maupun web circle). Tanpa kata sandi/token.
model LogLogin {
  id       String   @id @default(cuid())
  userId   String
  web      String   // 'app' atau slug circle
  ip       String?
  perangkat String?
  waktu    DateTime @default(now())

  @@index([userId, waktu])
  @@index([waktu])
}

// AUDIT PERUBAHAN ORDER (21 Okt 2026) — adaptasi OGS TransactionAuditLog: siapa mengubah apa (nilai, deadline, klien, kurs, tautan…).
// Perpindahan tahap tetap di RiwayatTahapOrder.
model AuditOrder {
  id       String   @id @default(cuid())
  orderId  String
  order    OrderProduksi @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId   String?
  nama     String
  aksi     String   // BUAT | UBAH | ITEM | TERMIN | TAUTAN | KONVERSI | LAINNYA
  field    String?
  dari     String?
  ke       String?
  waktu    DateTime @default(now())

  @@index([orderId, waktu])
}

// PROFIL SDM web circle (21 Okt 2026) — adaptasi OGS SdmProfile (posisi sekarang/berikutnya). Satu baris per orang.
model ProfilSdm {
  id            String   @id @default(cuid())
  userId        String   @unique
  posisiSekarang String?
  posisiBerikut String?
  catatan       String?
  diubahOlehId  String?
  updatedAt     DateTime @updatedAt
}

// LOG IMPERSONASI (21 Okt 2026) — Super Admin "masuk sebagai" pengguna lain di web circle, untuk bantuan/uji. Selalu tercatat.
model LogImpersonasi {
  id        String   @id @default(cuid())
  adminId   String
  targetId  String
  web       String
  alasan    String?
  waktu     DateTime @default(now())

  @@index([adminId, waktu])
  @@index([targetId, waktu])
}

// Tarif lembur per jam untuk lembur dari PRESENSI web circle (menit setelah jam kerja). Opsional per unit: kosong = lembur presensi hanya ditampilkan
// sebagai acuan di Payroll, TIDAK menambah uang. (Lembur Payroll Ekosistem yang lama berbasis progres × rate card, tetap jalan terpisah.)
// ATURAN LEMBUR PER UNIT (21 Okt 2026, keputusan user: aturan beda-beda tiap studio → koordinator unit menentukannya sendiri di web circle).
// Dihitung per HARI (utils/lembur.js): menit hari itu < minimalMenit → 0; dibulatkan ke bawah per pembulatanMenit; mode PER_JAM (tarifPerJam) /
// BERTINGKAT (tingkat: [{ sampaiJam|null, tarifPerJam }] per hari) / PER_HARI (tarifPerHari, sekali per hari lembur) / TIDAK_DIBAYAR;
// hari libur × pengaliLibur; total jam sebulan dibatasi batasJamBulanan. Lembur MANUAL wajib disetujui koordinator bila perluPersetujuan.
model PengaturanLembur {
  studioId          String   @id
  mode              String   @default("PER_JAM") // PER_JAM | BERTINGKAT | PER_HARI | PER_PROYEK | PER_LEVEL | TIDAK_DIBAYAR
  tarifPerJam       Float?
  tingkat           Json?    // BERTINGKAT: [{ sampaiJam: 2, tarifPerJam: 20000 }, { sampaiJam: null, tarifPerJam: 30000 }]
  tarifPerHari      Float?
  pengaliLibur      Float    @default(1)
  minimalMenit      Int      @default(0)
  pembulatanMenit   Int      @default(0) // 0 = tanpa pembulatan; 15/30/60 = dibulatkan ke bawah
  batasJamBulanan   Float?
  perluPersetujuan  Boolean  @default(true)  // lembur MANUAL menunggu persetujuan koordinator
  otomatisPerluSetuju Boolean @default(false) // lembur OTOMATIS (pulang lewat jam kerja) juga menunggu persetujuan
  catatan           String?
  diubahOleh        String?
  updatedAt         DateTime @updatedAt
}

// Foto CPM sebuah studio pada akhir bulan (4 Nov 2026): bulan yang sudah lewat tidak ikut berubah
// kalau ada anggota resign/THP diubah sesudahnya. Bulan berjalan tetap dihitung langsung (utils/cpm.js).
model StudioCpmBulanan {
  id                    String   @id @default(cuid())
  studioId              String
  bulan                 Int
  tahun                 Int
  totalThp              Float    @default(0)
  jumlahOrang           Int      @default(0)
  totalPengeluaranRutin Float    @default(0)
  totalShu              Float    @default(0)
  totalCpm              Float    @default(0)
  diubahOleh            String?
  diubahPada            DateTime?
  studio                Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())

  @@unique([studioId, bulan, tahun])
}

// Daftar level lembur per unit (mode PER_LEVEL): fee per level pekerjaan (mis. Revisi Minor 30rb, Level 1 100rb).
// Uang lembur = fee level × (progres akhir − progres awal). Sengaja terpisah dari RateCardLembur (Payroll Ekosistem) agar web circle mandiri.
model LevelLembur {
  id         String   @id @default(cuid())
  studioId   String
  nama       String
  produk     String   @default("") // "" = berlaku untuk semua produk; diisi bila fee level beda per produk (mis. 3D Printing / 3D Game)
  keterangan String?
  fee        Float
  aktif      Boolean  @default(true)
  urutan     Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([studioId, nama, produk])
  @@index([studioId])
}

// Tahap pekerjaan unit (mode PER_LEVEL): nama tahap → persen progres yang tercapai di akhir tahap (mis. Blocking 20%, Finishing 100%).
// Hanya pilihan cepat saat anggota mengisi progres; angka tetap boleh diketik.
model TahapLembur {
  id       String @id @default(cuid())
  studioId String
  nama     String
  persen   Int
  urutan   Int    @default(0)

  @@unique([studioId, nama])
  @@index([studioId])
}

// Pilihan kategori order/LTK per unit (10 Nov 2026, masukan tim): dipilih dari daftar agar tidak typo. Daftar yang ditampilkan =
// ini + kategori yang sudah dipakai di order/LTK unit (utils/kategori.js).
model KategoriOrder {
  id        String   @id @default(cuid())
  studioId  String
  nama      String
  createdAt DateTime @default(now())

  @@unique([studioId, nama])
  @@index([studioId])
}

// SETORAN MARKETER bebas waktu (10 Nov 2026, keputusan user): marketer mencatat SETIAP KALI menyetor pemasukan akun jualan ke kas studio —
// kapan saja, tanpa periode tetap tanggal 11/24 (aturan OGS) dan tanpa checklist "belum setor" otomatis. Pengganti ChecklistSetor (tabel lama dibiarkan sebagai riwayat).
model SetoranMarketer {
  id         String   @id @default(cuid())
  studioId   String
  marketerId String
  tanggal    DateTime @db.Date
  jumlah     Float?   // opsional (Rp)
  transferId String?  // opsional: transfer di Biaya & Kas → Pendapatan yang sama
  catatan    String?
  dicatatOleh String? // nama pencatat bila bukan marketernya sendiri (koordinator mencatatkan)
  createdAt  DateTime @default(now())

  @@index([studioId, tanggal])
  @@index([marketerId, tanggal])
}

// UPDATE KLIEN (10 Nov 2026, permintaan tim/Sekai Land): jejak kapan admin/marketer terakhir mengabari klien — supaya tak ada klien yang terlewat
// tanpa kabar ("ghosting"). jenis: PREVIEW | KATA (kabar singkat tanpa preview) | DELIVER = kontak ke klien; FEEDBACK_TALENT = masukan klien sudah
// diteruskan ke talent (bukan kontak ke klien). `otomatis` = tercatat dari aksi papan (keluar dari Preview klien / Delivery).
model UpdateKlien {
  id          String   @id @default(cuid())
  orderId     String
  order       OrderProduksi @relation(fields: [orderId], references: [id], onDelete: Cascade)
  studioId    String
  jenis       String
  catatan     String?
  otomatis    Boolean  @default(false)
  dicatatOlehId String?
  dicatatOleh String?
  waktu       DateTime @default(now())

  @@index([studioId, waktu])
  @@index([orderId, waktu])
}

// RINCIAN GAJI TETAP (10 Nov 2026, web circle): THP di Bio studio = TOTAL; koordinator memecahnya jadi komponen (mis. Uang makan, Transport, BPJS).
// Gaji pokok = THP Bio − Σ komponen tetap, jadi total tetap sama dengan THP di Bio. Dipakai ulang tiap bulan (tanpa input ulang).
model RincianGajiTetap {
  id       String @id @default(cuid())
  studioId String
  userId   String
  nama     String
  jumlah   Float
  urutan   Int    @default(0)

  @@index([studioId, userId])
}

// STATUS BAYAR BIAYA RUTIN per bulan (12 Nov 2026, masukan tim): baris rutin di buku besar (dari Bio: gaji/Dignity/SHU/langganan/iuran —
// sumber BIO; atau item tetap circle — ITEM_TETAP) ditandai SUDAH DIBAYAR pada tanggal & dari rekening tertentu → memotong saldo rekening itu
// pada tanggal bayar (bukan tgl 26 perkiraan). sumberId = id baris (mis. "gaji:<userId>", "shu", id StudioPengeluaranRutin, id ItemTetap).
model BayarRutin {
  id          String   @id @default(cuid())
  studioId    String
  bulan       String   // YYYY-MM
  sumber      String   // BIO | ITEM_TETAP
  sumberId    String
  dibayarPada DateTime @db.Date
  rekeningId  String?
  oleh        String?
  createdAt   DateTime @default(now())

  @@unique([studioId, bulan, sumber, sumberId])
}

// KOLOM KHUSUS ORDER per studio (12 Nov 2026, masukan tim): kebutuhan khusus tiap project yang dirancang studio sendiri,
// mis. "Boleh pakai AI?" (YA_TIDAK), "Gaya" (PILIHAN), "Catatan klien" (TEKS). Nilai per order di OrderProduksi.isianKhusus.
// diKartu = tampil sebagai label di kartu papan & antrean talent.
model KolomKhususOrder {
  id        String   @id @default(cuid())
  studioId  String
  nama      String
  tipe      String   // YA_TIDAK | PILIHAN | TEKS
  pilihan   String[] @default([])
  diKartu   Boolean  @default(true)
  urutan    Int      @default(0)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([studioId, aktif])
}
