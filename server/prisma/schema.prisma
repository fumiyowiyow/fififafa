  bulan      String
  terkunci   Boolean  @default(false)
  dibuatOleh String?
  createdAt  DateTime @default(now())

  @@index([studioId, bulan])
  @@index([sumberTipe, sumberId])
}

// Pindah dana antar rekening unit (tarik tunai, pindah bank) — tidak mengubah total kas, hanya saldo per rekening (12 Nov 2026).
