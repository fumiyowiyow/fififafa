  variabel    Float?
  tetap       Float?
  kasAkhir    Float?
  ditutupPada DateTime?
  saldoAwalRekening Json? // { [rekeningId]: saldo } diisi koordinator (12 Nov 2026)
  saldoRekening     Json? // snapshot saat ditutup: { awal: {...}, akhir: {...} }
  bioDisamakanPada  DateTime? // tombol "Perbarui saldo Bio dari circle" (opsi 2, keputusan user 12 Nov 2026)
  bioDisamakanOleh  String?
