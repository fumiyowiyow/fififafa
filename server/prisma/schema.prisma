  kategoriId  String
  kategori    KategoriLedger @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  studioId    String? // null = berlaku untuk semua unit
  userId      String?
  nama        String
  jumlahBawaan Float   @default(0)
  urutan      Int      @default(0)
