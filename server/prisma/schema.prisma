// ══════════════════════════════════════════════════════════════════════════
// BUKU BESAR & TUTUP BULAN (20 Okt 2026) — adaptasi OGS Finance V2/V4 (Category, FixedItem(+Override), LedgerEntry, MonthStatus,
// ClosingLedgerSyncService, TutupBulanService, RingkasanService). MODE BAYANGAN: kas akhir & status bulan disimpan di sini,
// BUKAN di WeeklyReport / StudioMonthlyNote Ekosistem. Transfer yang dikirim/dikonfirmasi + biaya DISETUJUI → ledger; item tetap
// ditambahkan saat tutup bulan; semua dikunci. Uang dalam Rupiah.
// ══════════════════════════════════════════════════════════════════════════
model KategoriLedger {
  id        String   @id @default(cuid())
  studioId  String?
  nama      String
  arus      String   // INCOME | EXPENSE
  sifat     String?  // TETAP | VARIABEL (null untuk INCOME)
  urutan    Int      @default(0)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  item      ItemTetap[]
  entri     EntriLedger[]

  @@index([arus, urutan])
}

model ItemTetap {
