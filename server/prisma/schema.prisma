// ══════════════════════════════════════════════════════════════════════════
// PENUGASAN PER TAHAP, KEAHLIAN & ANTREAN (20 Okt 2026) — adaptasi OGS TransactionItemAssignment (work_state, progress, queue_priority),
// DesignerStageSkill, ProducerGenreSkill, AutoAssignService, ReassignmentSuggestionService. Baris dibuat otomatis saat order MASUK
// tahap kerja (KERJA / REVISI) untuk orang yang ditugaskan di order; ditutup saat order meninggalkan tahap itu. Menajamkan analitik
// kinerja per orang. Penugasan otomatis hanya bila diaktifkan per unit (PengaturanPenugasan).
// ══════════════════════════════════════════════════════════════════════════
model PenugasanTahap {
  id           String        @id @default(cuid())
  orderId      String
  order        OrderProduksi @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tahapId      String?
  tahap        TahapProduksi? @relation(fields: [tahapId], references: [id], onDelete: SetNull)
  namaTahap    String
  jenisTahap   String
  userId       String
  status       String        @default("MENUNGGU") // MENUNGGU | DIKERJAKAN | SELESAI
  progres      Int           @default(0)
  catatanKerja String?
  dijadwalkan  DateTime?     @db.Date
  ditugaskanPada DateTime    @default(now())
  mulaiPada    DateTime?
  selesaiPada  DateTime?
  urutanAntrean Int? // override koordinator; null = FIFO menurut ditugaskanPada
  mendesak     Boolean       @default(false) // OGS queue_priority=0: selalu di atas antrean orangnya
  tunda        Boolean       @default(false) // 12 Nov 2026 (masukan tim): admin menunda — tidak masuk Antreanku talent hari ini (tetap di Tugasku: prioritas berikutnya / lembur)
  ditugaskanOleh String?
  otomatis     Boolean       @default(false)

  @@index([userId, status])
  @@index([orderId, tahapId])
}

model KeahlianTahap {
  id           String   @id @default(cuid())
  studioId     String
  userId       String
  tahapId      String
  tahap        TahapProduksi @relation(fields: [tahapId], references: [id], onDelete: Cascade)
  akunId       String? // null = semua akun
  maksKesulitan String  @default("MUDAH") // MUDAH | SEDANG | SULIT
  createdAt    DateTime @default(now())

  @@index([studioId, tahapId])
  @@index([userId])
}

model KeahlianGenre {
  id           String   @id @default(cuid())
  studioId     String
  userId       String
  genre        String
  maksKesulitan String  @default("MUDAH")
  createdAt    DateTime @default(now())

  @@unique([studioId, userId, genre])
}

model PengaturanPenugasan {
  studioId  String   @id
  otomatis  Boolean  @default(false)
  alurDisetujui Boolean @default(false) // koordinator sudah memeriksa alur kerja ('Mulai di sini' langkah 3) — tersimpan di server, bukan di peramban
  qcSemua   Boolean  @default(false) // 12 Nov 2026 (masukan tim): semua hasil talent (Pengerjaan, Revisi klien, Finalisasi) dicek admin di QC dulu
  updatedAt DateTime @updatedAt
}

// ══════════════════════════════════════════════════════════════════════════
// DISKUSI KEPUTUSAN & OTOMATISASI (20 Okt 2026) — adaptasi OGS DecisionThread/Participant/Message/Mention + AutomationRun
// (DeadlineUnassignedService, StuckQcEscalationService). TANPA lampiran berkas: hanya tautan. Pesan otomatis ditulis oleh "Otomasi".
// ══════════════════════════════════════════════════════════════════════════
model DiskusiKeputusan {
  id          String   @id @default(cuid())
  studioId    String
  orderId     String? // subjek (opsional)
  judul       String
  deskripsi   String?
  tautan      String[] @default([])
  status      String   @default("TERBUKA") // TERBUKA | DIPUTUSKAN | DIBATALKAN
  dibuatOlehId String? // null = Otomasi
  dibuatOleh  String
  otomatis    Boolean  @default(false)
  diputuskanOleh String?
  diputuskanPada DateTime?
  ringkasanKeputusan String?
  dibatalkanOleh String?
  dibatalkanPada DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  peserta     PesertaDiskusi[]
  pesan       PesanDiskusi[]

  @@index([studioId, status])
  @@index([orderId])
