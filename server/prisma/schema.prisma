  diskusiId   String
  diskusi     DiskusiKeputusan @relation(fields: [diskusiId], references: [id], onDelete: Cascade)
  userId      String? // null = Otomasi
  nama        String
  indukId     String?
  isi         String
  tautan      String[] @default([])
  sebut       String[] @default([]) // userId yang disebut
  dihapusPada DateTime?
  createdAt   DateTime @default(now())

  @@index([diskusiId, createdAt])
}

model LogOtomasi {
  id          String   @id @default(cuid())
  aturan      String
  subjekTipe  String?
  subjekId    String?
  kunciDedup  String
  aksi        String
  payload     Json?
  createdAt   DateTime @default(now())

  @@unique([aturan, kunciDedup])
  @@index([aturan, subjekTipe, subjekId])
}

